RewriteEngine On

# Redirect HTTP to HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Redirect www to non-www
RewriteCond %{HTTP_HOST} ^www\.estawredli\.com$ [NC]
RewriteRule ^(.*)$ https://estawredli.com/$1 [L,R=301]

RewriteCond %{HTTP_HOST} ^www\.estawredly\.com$ [NC]
RewriteRule ^(.*)$ https://estawredli.com/$1 [L,R=301]

RewriteCond %{HTTP_HOST} ^estawredly\.com$ [NC]
RewriteRule ^(.*)$ https://estawredli.com/$1 [L,R=301]

# Redirect deleted containers page to homepage
RewriteRule ^containers(\.html)?$ / [R=301,L]
